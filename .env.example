# ---------------------------------------------------------------------------
# Payment Portal — environment variables
# Copy to .env.local (local) or set in Vercel → Project → Settings → Environment Variables.
# Generate secrets with:  npm run gen:keys
# ---------------------------------------------------------------------------

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (port 6543)
# e.g. postgres://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Set to "disable" only for a local Postgres without TLS
DATABASE_SSL=require

# Supabase → Project Settings → API (keys are used on the server only, never sent to the browser)
SUPABASE_URL=https://<project-ref>.supabase.co
# "anon" key (or the new "publishable" key sb_publishable_…)
SUPABASE_ANON_KEY=
# "service_role" key (or the new "secret" key sb_secret_…) — keep secret
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel URL (where you and your sellers log in)
APP_URL=https://portal.yourcompany.com
# Optional: extra hostnames allowed to serve the admin panel (comma separated)
ADMIN_HOSTS=

# 32-byte base64 key for AES-256-GCM encryption of gateway keys and SMTP passwords
ENCRYPTION_KEY=
# During key rotation: previous keys, comma separated (decrypt-only)
ENCRYPTION_KEYS_PREVIOUS=
# Server-side pepper for hashing pay-link tokens and API secrets
APP_SECRET=

# One-time token required on /setup to create the first admin (delete after setup)
SETUP_TOKEN=
# Bearer token for /api/cron (Vercel Cron sends it automatically when set as CRON_SECRET)
# Vercel Hobby runs it once a day; for hourly runs use Vercel Pro or a free external cron.
CRON_SECRET=

# Name shown in authenticator apps (Supabase MFA)
TOTP_ISSUER=Payment Portal

# System email (SMTP) for security alerts to admins
SYSTEM_FROM_EMAIL=alerts@yourcompany.com
# smtps://user:pass@smtp.host.com:465  or  smtp://user:pass@smtp.host.com:587
# (URL-encode special characters in the password, e.g. @ → %40)
SYSTEM_SMTP_URL=

# NOTE: Stripe / PayPal keys are NOT environment variables. Add them in the
# admin panel under Merchants — they are stored AES-256 encrypted per merchant,
# so you can run many Stripe / PayPal accounts side by side.

# Optional: lets "Connect subdomain" add brand payment subdomains to Vercel automatically.
# Vercel → Account Settings → Tokens (scope: the team that owns the project)
VERCEL_API_TOKEN=
# Vercel → payment-portal → Settings → General → Project ID
VERCEL_PROJECT_ID=
# Team ID (starts with team_), leave empty for a personal account
VERCEL_TEAM_ID=
